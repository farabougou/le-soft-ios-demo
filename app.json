    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lesoft.ios.concept",
      "associatedDomains": [
        "applinks:lesoftpost.com",
        "applinks:www.lesoftpost.com"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Le Soft",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lesoft.android.concept",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lesoftpost.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.lesoftpost.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
